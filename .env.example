# Copy this file to .env.local and fill in real values.

# Supabase — find these in your project's API settings:
# https://supabase.com/dashboard/project/hukwgvbqtxvakncdjwwy/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://hukwgvbqtxvakncdjwwy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Gemini (server-side only — never expose this to the browser)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Snwolley AI (Npontu hackathon) — server-side only, used by /api/voice
SNWOLLEY_API_KEY=your-snwolley-api-key
# Chat model name accepted by https://v1.snwolley.ai/v1/chat/completions
SNWOLLEY_MODEL=snwolley-chat
